# ==============================================================================
# SmokerKhata Environment Configuration Reference
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-in-production
DJANGO_DEBUG=false
ALLOWED_HOSTS=smokerkhata.com,api.smokerkhata.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://user:password@localhost:5432/smokerkhata_db
CONN_MAX_AGE=60

# Background Worker & Web Concurrency (Memory Target: <512MB RAM with 2 workers)
WEB_CONCURRENCY=2

# Authentication & SMS Providers
# Options: accounts.sms.console.ConsoleSMSBackend | accounts.sms.file.FileSMSBackend | accounts.sms.real.RealSMSBackend
SMS_BACKEND=accounts.sms.console.ConsoleSMSBackend

# Observability & Monitoring
SENTRY_DSN=
ENVIRONMENT=production

# Disaster Recovery & Backups
BACKUP_ENCRYPTION_KEY=your-32-byte-or-strong-gpg-passphrase
BACKUP_S3_BUCKET=smokerkhata-backups
BACKUP_DIR=/var/backups/smokerkhata

# Security & SSL
SECURE_SSL_REDIRECT=true
